<?xml version="1.0"?>
<ruleset name="generator-core">
	<description>
		PSR-12. This package has no CMS in it, so none of the Joomla exceptions
		that other repositories in this family need apply here.
	</description>

	<file>src</file>
	<file>tests</file>
	<file>build</file>

	<exclude-pattern>*/vendor/*</exclude-pattern>
	<!-- Generated output: reviewed as a diff, not as hand-written source. -->
	<exclude-pattern>*/tests/Fixtures/expected/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="sp"/>

	<rule ref="PSR12"/>

	<rule ref="Generic.Files.LineLength">
		<properties>
			<property name="lineLimit" value="150"/>
			<property name="absoluteLineLimit" value="0"/>
		</properties>
	</rule>
</ruleset>
