{
	"name": "yepr/generator-core",
	"description": "A framework-agnostic code generation engine: model in, file set out.",
	"type": "library",
	"license": "GPL-3.0-or-later",
	"authors": [
		{
			"name": "Herman Peeren",
			"email": "herman@yepr.nl",
			"homepage": "https://yepr.nl"
		}
	],
	"require": {
		"php": ">=8.3"
	},
	"require-dev": {
		"friendsofphp/php-cs-fixer": "^3.0",
		"phpstan/phpstan": "^2.0",
		"phpstan/phpstan-deprecation-rules": "^2.0",
		"phpunit/phpunit": "^11.0",
		"squizlabs/php_codesniffer": "^3.0"
	},
	"autoload": {
		"psr-4": {
			"Yepr\\Gen\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"Yepr\\Gen\\Core\\Tests\\": "tests/"
		}
	},
	"scripts": {
		"test": "phpunit",
		"analyse": "phpstan analyse",
		"cs": "phpcs",
		"cs-fix": "php-cs-fixer fix",
		"cs-fix-dry": "php-cs-fixer fix --dry-run --diff"
	},
	"config": {
		"sort-packages": true
	}
}
